# .env file for LankaShield project
# OpenWeatherMap API key for weather data fetching
OPENWEATHER_API_KEY=YOUR_API_KEY_HERE

# Path to dengue case CSV (absolute or relative to project root)
DENGUE_CASES_PATH=./data/dengue_cases.csv

# Path to raw weather CSV (generated by weather_data script)
WEATHER_CSV_PATH=./data/weather_raw.csv

# Path to lagged weather features CSV (generated by feature_engineering script)
WEATHER_LAG_FEATURES_PATH=./data/weather_lag_features.csv

# Path to model output file
MODEL_PATH=./model/model.pkl

# Path to predictions output (used by dashboard)
PREDICTIONS_PATH=./data/predictions.csv
